@@ -0,0 +1,261 @@
+"""OpenAI 兼容层 —— 把 character-chat 当成一台「本地模型」暴露出去。
+
+谁在用：AIRI（浏览器里的 Live2D / VRM 舞台）把它配成 `openai-compatible`
+provider。于是分工变成——AIRI 只负责嘴和脸，人设 / 记忆 / 心境 / 时间场景
+全部留在这一侧。
+
+两条铁律：
+
+1. **前端发来的 system prompt 和历史一律丢掉。** 脑在这边，不在那边。
+   每次只取最后一条 user 文本进管线，其余都是 AIRI 自己的壳。
+2. **和微信那条路共用同一个 Cli 实例**（session_id="default"）。
+   各建一个实例就会变成「同一个凌暮雪，两份互不相通的记忆」。
+
+上游模型走 config.yaml 的 `llm:` / `local_llm:`；本机就是 llama-server
+网关（OpenAI 协议，127.0.0.1:8001）。
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import re
+import time
+import uuid
+from functools import partial
+from typing import Any, AsyncIterator, Optional
+
+from fastapi import APIRouter, Request
+from fastapi.responses import JSONResponse, StreamingResponse
+from loguru import logger
+
+router = APIRouter(tags=["openai-compat"])
+
+#: 对外报的「模型名」。填什么都行，真正的人设在这边。
+MODEL_ALIAS = "ling-muxue"
+
+#: 流式吐字之间的小停顿，让 AIRI 那边看起来像在说话，
+#: 而不是一坨字砸下来再慢慢渲染。
+_STREAM_DELAY = 0.02
+
+#: 攒够多少字就切一刀（中文标点优先切）。
+_STREAM_CHUNK = 24
+
+_DATA_URL_RE = re.compile(r"^data:(?P<mime>[\w.+/-]+);base64,(?P<data>.+)$", re.S)
+
+#: 任务标签在 AIRI 那条路上没有「批准」环节，原样吐出去只会让学长看到一串 XML。
+_TASK_TAG_RE = re.compile(r"<task_request>.*?</task_request>|<task>.*?</task>", re.S | re.I)
+
+
+def _last_user_text(messages: Any) -> str:
+    """取最后一条 user 消息的纯文本。前端的 system / 历史全部忽略。"""
+    if not isinstance(messages, list):
+        return ""
+    for msg in reversed(messages):
+        if not isinstance(msg, dict) or msg.get("role") != "user":
+            continue
+        content = msg.get("content")
+        if isinstance(content, str):
+            return content.strip()
+        if isinstance(content, list):
+            texts = [
+                part.get("text") or ""
+                for part in content
+                if isinstance(part, dict) and part.get("type") == "text"
+            ]
+            return "\n".join(t for t in texts if t).strip()
+    return ""
+
+
+def _last_user_images(messages: Any) -> Optional[list]:
+    """抠出最后一条 user 消息里的 data-url 图片，转成 cli.send 认识的格式。
+
+    只收 `data:` URL。http(s) 的图片这里拿不到字节，跳过而不是假装看过。
+    """
+    if not isinstance(messages, list):
+        return None
+    for msg in reversed(messages):
+        if not isinstance(msg, dict) or msg.get("role") != "user":
+            continue
+        content = msg.get("content")
+        if not isinstance(content, list):
+            return None
+        images = []
+        for part in content:
+            if not isinstance(part, dict) or part.get("type") != "image_url":
+                continue
+            url = ((part.get("image_url") or {}) or {}).get("url") or ""
+            matched = _DATA_URL_RE.match(url) if isinstance(url, str) else None
+            if matched:
+                images.append({"mime": matched.group("mime"), "data": matched.group("data")})
+            elif url:
+                logger.warning("[openai] 跳过非 data-url 图片：拿不到字节")
+        return images or None
+    return None
+
+
+async def _ask_brain(user_text: str, images: Optional[list]) -> str:
+    """把一条 user 文本送进 Cli，拿回凌暮雪的回复。"""
+    # 延迟导入：server 在模块末尾 include 本模块，顶层导入会绕成循环。
+    from character_chat.server import _get_cli, _send_locked
+
+    cli = await _get_cli("default")
+    loop = asyncio.get_event_loop()
+    reply = await loop.run_in_executor(
+        None,
+        partial(_send_locked, cli, skip_record=False, images=images),
+        user_text,
+    )
+    return _TASK_TAG_RE.sub("", reply or "").strip()
+
+
+def _split_for_stream(text: str) -> list[str]:
+    """按标点切句；切得太碎就攒够 _STREAM_CHUNK 字再放。"""
+    pieces: list[str] = []
+    buffer = ""
+    for char in text:
+        buffer += char
+        soft_break = char in "，,；;：:、"
+        if char in "。！？!?…\n" or len(buffer) >= _STREAM_CHUNK or (soft_break and len(buffer) >= 12):
+            pieces.append(buffer)
+            buffer = ""
+    if buffer:
+        pieces.append(buffer)
+    return pieces
+
+
+def _estimate_usage(prompt_text: str, reply: str) -> dict:
+    """粗估 token 数。
+
+    中文大约 1 字 1 token、英数大约 4 字符 1 token，取中除以 2。
+    只是为了 OpenAI 协议里的 usage 字段有值，别拿它当账。
+    """
+    def estimate(text: str) -> int:
+        return max(1, len(text) // 2)
+
+    prompt_tokens = estimate(prompt_text)
+    completion_tokens = estimate(reply)
+    return {
+        "prompt_tokens": prompt_tokens,
+        "completion_tokens": completion_tokens,
+        "total_tokens": prompt_tokens + completion_tokens,
+    }
+
+
+def _chunk(model: str, completion_id: str, created: int, delta: dict, finish: Optional[str] = None) -> str:
+    payload = {
+        "id": completion_id,
+        "object": "chat.completion.chunk",
+        "created": created,
+        "model": model,
+        "choices": [{"index": 0, "delta": delta, "finish_reason": finish}],
+    }
+    return f"data: {json.dumps(payload, ensure_ascii=False)}\n\n"
+
+
+async def _stream(reply: str, model: str, include_usage: bool) -> AsyncIterator[str]:
+    completion_id = f"chatcmpl-{uuid.uuid4().hex[:24]}"
+    created = int(time.time())
+
+    yield _chunk(model, completion_id, created, {"role": "assistant", "content": ""})
+    for piece in _split_for_stream(reply):
+        yield _chunk(model, completion_id, created, {"content": piece})
+        await asyncio.sleep(_STREAM_DELAY)
+    yield _chunk(model, completion_id, created, {}, finish="stop")
+
+    if include_usage:
+        yield f"data: {json.dumps({
+            'id': completion_id,
+            'object': 'chat.completion.chunk',
+            'created': created,
+            'model': model,
+            'choices': [],
+            'usage': _estimate_usage('', reply),
+        }, ensure_ascii=False)}\n\n"
+
+    yield "data: [DONE]\n\n"
+
+
+@router.get("/v1/models")
+async def list_models() -> dict:
+    """有的前端会先探这个再填模型名。"""
+    return {
+        "object": "list",
+        "data": [
+            {
+                "id": MODEL_ALIAS,
+                "object": "model",
+                "created": 0,
+                "owned_by": "character-chat",
+            },
+        ],
+    }
+
+
+@router.post("/v1/chat/completions")
+async def chat_completions(request: Request):
+    """OpenAI 协议的对话入口：只认最后一条 user 文本，回凌暮雪的话。"""
+    try:
+        body = await request.json()
+    except Exception:
+        body = {}
+    if not isinstance(body, dict):
+        body = {}
+
+    messages = body.get("messages") or []
+    model = body.get("model") or MODEL_ALIAS
+    stream = bool(body.get("stream"))
+    include_usage = bool((body.get("stream_options") or {}).get("include_usage"))
+
+    user_text = _last_user_text(messages)
+    if not user_text:
+        return JSONResponse(status_code=400, content={
+            "error": {
+                "message": "没有可用的 user 消息",
+                "type": "invalid_request_error",
+                "code": "empty_user_message",
+            },
+        })
+
+    images = _last_user_images(messages)
+    started = time.monotonic()
+    try:
+        reply = await _ask_brain(user_text, images)
+    except Exception as e:
+        logger.exception("[openai] 生成失败")
+        return JSONResponse(status_code=502, content={
+            "error": {
+                "message": f"character-chat 生成失败：{type(e).__name__}: {e}",
+                "type": "upstream_error",
+            },
+        })
+
+    logger.info(
+        f"[openai] stream={stream} model={model} images={len(images or [])} "
+        f"user={user_text[:40]!r} → {len(reply)} 字 {time.monotonic() - started:.1f}s"
+    )
+
+    if stream:
+        return StreamingResponse(
+            _stream(reply, model, include_usage),
+            media_type="text/event-stream",
+            headers={
+                "Cache-Control": "no-cache",
+                "Connection": "keep-alive",
+                "X-Accel-Buffering": "no",
+            },
+        )
+
+    return {
+        "id": f"chatcmpl-{uuid.uuid4().hex[:24]}",
+        "object": "chat.completion",
+        "created": int(time.time()),
+        "model": model,
+        "choices": [
+            {
+                "index": 0,
+                "message": {"role": "assistant", "content": reply},
+                "finish_reason": "stop",
+            },
+        ],
+        "usage": _estimate_usage(user_text, reply),
+    }
